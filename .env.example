# Copier ce fichier en .env et remplacer les valeurs "changer-moi"
# Le fichier .env n'est jamais committé (voir .gitignore)

# Backend
PORT=3000

# MQTT (Mosquitto)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=datamonstre
MQTT_PASSWORD=changer-moi

# PostgreSQL
POSTGRES_DB=datamonstre
POSTGRES_USER=datamonstre
POSTGRES_PASSWORD=changer-moi
DATABASE_HOST=localhost
DATABASE_PORT=5432
